services:
  frontend:
    build:
      context: .
      dockerfile: Dockerfile
    user: "${LOCAL_UID:-1000}:${LOCAL_GID:-1000}"
    ports:
      - "5173:5173"
    volumes:
      - .:/app
      - node_modules:/app/node_modules
      - ../../Projects:/projects
    environment:
      - NODE_ENV=development
      - SONGWRITER_PROJECTS_ROOT=/projects
    stdin_open: true
    tty: true

volumes:
  node_modules:
